# Caddy reverse proxy configuration for CONNECT Manager
# Automatic HTTPS via Let's Encrypt with DNS-01 challenge (Cloudflare)

{
    # Use DNS-01 challenge - no port 80 required, works with multiple Caddy instances
    acme_dns cloudflare {env.CF_API_TOKEN}
}

{$DOMAIN} {
    reverse_proxy web:8000

    # Security headers
    header {
        # Prevent clickjacking
        X-Frame-Options "SAMEORIGIN"
        # Prevent MIME type sniffing
        X-Content-Type-Options "nosniff"
        # XSS protection
        X-XSS-Protection "1; mode=block"
        # Referrer policy
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # Logging
    log {
        output stdout
        format console
    }
}
