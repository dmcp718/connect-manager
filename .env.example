# CONNECT Manager - Environment Variables
# Copy to .env and configure for your deployment

# =============================================================================
# PRODUCTION SETTINGS (required for ./run.sh prod)
# =============================================================================

# Your domain name (e.g., connect.example.com)
# DOMAIN=connect.example.com

# Cloudflare API token for DNS-01 ACME challenge
# Create at: Cloudflare Dashboard → My Profile → API Tokens → "Edit zone DNS" template
# CF_API_TOKEN=your-cloudflare-api-token-here

# JWT secret key - generate with: openssl rand -hex 32
# JWT_SECRET_KEY=your-64-character-hex-secret-here

# Initial admin account (created on first startup if no users exist)
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=your-secure-password-here

# =============================================================================
# GENERAL SETTINGS
# =============================================================================

# LucidLink API host
# LL_API_HOST=https://admin-api.solutions-eng.online/api/v1

# Session duration in minutes (default: 480 = 8 hours)
# ACCESS_TOKEN_EXPIRE_MINUTES=480

# =============================================================================
# INTERNAL (usually don't need to change)
# =============================================================================

# Valkey/Redis connection
VALKEY_HOST=valkey
VALKEY_PORT=6379

# Data directory for SQLite
DATA_DIR=/data

# ARQ worker settings
ARQ_MAX_JOBS=4
