# LucidLink Labs - Docker Environment Variables

# Valkey/Redis connection (defaults shown)
VALKEY_HOST=valkey
VALKEY_PORT=6379

# Data directory for SQLite and secrets
DATA_DIR=/data

# ARQ worker settings
ARQ_MAX_JOBS=4

# Optional: Pre-configure secrets via environment
# LL_LUCIDLINK_API_TOKEN=your-token-here
# LL_AWS_ACCESS_KEY=your-access-key
# LL_AWS_SECRET_KEY=your-secret-key
